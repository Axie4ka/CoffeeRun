<?xml version="1.0" encoding="utf-8"?>
<!--
   Резервная копия на Android 11 и старше (на 12+ действует data_extraction_rules.xml).
   Токен входа (DataStore «auth») не копируется: это ключ от аккаунта.
   См. https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="file" path="datastore/auth.preferences_pb" />
</full-backup-content>
