<?xml version="1.0" encoding="utf-8"?>
<!--
   Что копируется в облако Google и при переносе на новый телефон (Android 12+).
   Токен входа (DataStore «auth») не копируется: это ключ от аккаунта, на новом телефоне входят заново.
   См. https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
